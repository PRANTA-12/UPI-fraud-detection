# Copy to .env  (or run: python scripts/generate_env.py). NEVER commit .env.
APP_ENV=development            # development | production
LOG_LEVEL=INFO

# --- PostgreSQL (inside Docker the API talks to host "db" on port 5432)
POSTGRES_DB=upi_fraud_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_HOST_PORT=5433               # port published on YOUR machine (127.0.0.1 only)
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require     # e.g. Neon; overrides DB_*

# --- Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
STREAM_NAME=transactions_stream
DLQ_STREAM_NAME=transactions_stream:dlq
CONSUMER_GROUP=fraud_consumer_group
ALERT_CHANNEL=fraud_alerts

# --- Replay producer (stand-in for a real transaction source)
PRODUCER_MIN_DELAY_MS=200
PRODUCER_MAX_DELAY_MS=1500
PRODUCER_FRAUD_BOOST=0.03       # demo sampling of real labelled fraud rows (held-out period only); set 0 for the faithful 0.13% rate
PRODUCER_REPLAY_FROM=heldout    # heldout = only transactions the model never trained on (honest live metrics) | all

# --- Stream reliability
MAX_RETRIES=5
RETRY_IDLE_MS=30000

# --- Security
JWT_SECRET=                     # >= 32 random chars (generate_env.py fills this in)
ACCESS_TOKEN_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                 # seeds the first admin user (only if it does not exist yet)
AUTH_REQUIRED=true
WS_REQUIRE_AUTH=true
LEGACY_ENDPOINTS_PUBLIC=true    # keep original GET / , /health, /stream/status, POST /predict open
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
